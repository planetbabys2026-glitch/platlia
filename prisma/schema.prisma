// Modelo de datos de Platlia.
//
// Convenciones que valen para todo el archivo:
//
//  · Los nombres de modelos y campos van en inglés; los valores de los enums van
//    en español porque son vocabulario del producto: aparecen tal cual en la
//    interfaz y algunos ya tienen token de diseño (bg-mesa-libre, bg-mesa-ocupada).
//  · El dinero es `Int` en pesos colombianos enteros, sufijo `Cop`. Ni Decimal ni
//    BigInt: ninguno de los dos cruza el límite RSC → Client Component.
//  · Las tasas de impuesto son `Int` en puntos básicos: 800 = 8%, 1900 = 19%.
//  · Todo instante es `@db.Timestamptz(3)`. La única excepción es `businessDate`,
//    que es `@db.Date` porque representa un día de calendario, no un instante:
//    se calcula siempre en la aplicación con lib/time.ts y viaja como parámetro.
//    Está prohibido derivarlo en SQL con CURRENT_DATE o now()::date.
//  · La unidad de tenencia es `Business` = una sucursal. El precio es por negocio
//    con una sucursal incluida, así que un segundo local es otro Business (y otra
//    suscripción) del mismo dueño, unidos por sus Membership. Por eso no existe
//    un modelo Branch: agregarlo obligaría a llevar branchId en cada consulta y a
//    duplicar el scoping que tenantDb() ya resuelve con businessId solo.
//  · Todo modelo con `businessId` es un modelo de inquilino y se consulta con
//    tenantDb(businessId), nunca con el cliente base.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  PROPIETARIO
  ADMINISTRADOR
  CAJERO
  MESERO
  COCINA
}

/// Los módulos se activan y desactivan por empresa: un bar sin cocina no debería
/// ver la pantalla de comandas. No son un plan de precios —todos están incluidos—
/// sino la superficie que cada negocio decide usar. Los verifica requireModule().
enum AppModule {
  MESAS
  PEDIDOS
  COCINA
  CAJA
  INFORMES
  INVENTARIO
}

enum BusinessStatus {
  ACTIVO
  SUSPENDIDO
  CANCELADO
}

enum UserStatus {
  ACTIVO
  SUSPENDIDO
}

enum SessionKind {
  APP
  SUPERADMIN
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SubscriptionStatus {
  PRUEBA
  ACTIVA
  VENCIDA
  SUSPENDIDA
  CANCELADA
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
  CONTRACARGO
}

/// En Colombia un restaurante o bar cobra impuesto al consumo (8%) y queda
/// excluido de IVA sobre esa misma venta. Los negocios que no están en el régimen
/// simple pueden facturar IVA (19%), y hay productos exentos.
enum TaxKind {
  IMPOCONSUMO
  IVA
  EXENTO
}

enum TableStatus {
  LIBRE
  OCUPADA
  CUENTA_PEDIDA
  RESERVADA
  INACTIVA
}

enum OrderType {
  MESA
  LLEVAR
  DOMICILIO
}

enum OrderChannel {
  POS
  MESERO
  MESA_QR
  DOMICILIO_QR
}

enum OrderStatus {
  ABIERTA
  CUENTA_PEDIDA
  PAGADA
  ANULADA
}

/// El recorrido de un domicilio, que NO es el de la cuenta.
///
/// `OrderStatus` dice si la venta está cobrada; esto dice dónde está la comida.
/// Un domicilio puede estar cobrado y todavía en la moto, o entregado y sin
/// cobrar si el repartidor cobra al llegar.
///
/// El orden es el del flujo y ninguna transición se saltea: las reglas puras
/// están en `features/domicilios/reglas.ts`. `LISTO` es el estado que faltaba
/// —cocina terminó y todavía no se cobró—, y es lo que decide que un domicilio
/// aparezca en caja: antes entraba desde que nacía.
enum DeliveryStatus {
  POR_CONFIRMAR
  EN_PREPARACION
  LISTO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum OrderItemStatus {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  ANULADO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  NEQUI
  DAVIPLATA
  TRANSFERENCIA
  BONO
  OTRO
}

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO
  EGRESO
  RETIRO
  AJUSTE
}

/// Para qué sirve cada impresora del local.
///
/// No es lo mismo la de la caja que la de la plancha: una imprime el recibo del
/// cliente y la otra la comanda de la cocina, y en un bar están en dos cuartos
/// distintos.
enum PrinterRole {
  RECIBO
  COMANDA
}

/// El recorrido de un trabajo de impresión.
///
/// `RECLAMADO` existe porque puede haber más de un agente corriendo —una PC en la
/// caja y otra en la cocina—: el reclamo con caducidad es lo que evita que dos
/// impriman el mismo recibo. Es la misma guarda que usa la emisión DIAN.
enum PrintJobStatus {
  PENDIENTE
  RECLAMADO
  IMPRESO
  ERROR
}

/// Adónde va la comanda de cocina.
///
/// El KDS no le sirve a todo el mundo: hay cocinas sin pantalla y hay bares que
/// quieren las dos cosas. Es un ajuste de `BusinessSettings` y no un `AppModule`
/// porque aquel enum significa "qué superficie usa el negocio", no "cómo sale el
/// papel".
enum ComandaDestino {
  KDS
  IMPRESA
  AMBAS
}

enum ReceiptWidth {
  MM55
  MM80
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenencia
// ─────────────────────────────────────────────────────────────────────────────

model Business {
  id     String         @id @default(cuid())
  /// Aparece en URLs y en el nombre de la carpeta de Cloudinary. Inmutable en la
  /// práctica: cambiarlo rompe enlaces guardados y mueve archivos ya subidos.
  slug   String         @unique
  name   String
  status BusinessStatus @default(ACTIVO)

  /// Datos que salen impresos en el tiquete. El NIT es opcional porque muchos
  /// negocios se registran antes de tenerlo a mano.
  legalName String?
  taxId     String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  settings      BusinessSettings?
  subscription  Subscription?
  modules       BusinessModule[]
  taxRates      TaxRate[]
  memberships   Membership[]
  sessions      Session[]
  categories    Category[]
  products      Product[]
  areas         Area[]
  tables        Table[]
  orders        Order[]
  orderItems    OrderItem[]
  orderPayments OrderPayment[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]
  payments      SubscriptionPayment[]
  printers      Printer[]
  printRoutes   PrintRoute[]
  printJobs     PrintJob[]
  printAgents   PrintAgent[]
  tokensIa      TokenIa[]
  auditLogs     AuditLog[]

  inventoryItems       InventoryItem[]
  suppliers            Supplier[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  productRecipeItems   ProductRecipeItem[]
  inventoryMovements   InventoryMovement[]

  modifierGroups         ModifierGroup[]
  modifierOptions        ModifierOption[]
  modifierOptionSupplies ModifierOptionSupply[]
  productModifierGroups  ProductModifierGroup[]
  orderItemModifiers     OrderItemModifier[]

  @@index([status])
}

/// Parámetros de operación. Ningún valor de negocio vive como constante global:
/// todo lo que un dueño podría querer distinto está acá, con el valor por defecto
/// colombiano.
model BusinessSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Zona horaria IANA. Todo cálculo de día pasa por lib/time.ts con este valor.
  timeZone String @default("America/Bogota")

  /// Minutos después de medianoche en que empieza el día de negocio. Un bar que
  /// cierra a las 3 a.m. tiene que ver esas ventas en el día anterior, o el cierre
  /// de caja nunca cuadra. 300 = 5:00 a.m.
  businessDayStartMinutes Int @default(300)

  /// En Colombia la carta se publica con el impuesto incluido. Si esto es true,
  /// `Product.priceCop` es el precio final y el impuesto se desagrega hacia atrás.
  pricesIncludeTax Boolean @default(true)

  /// La propina es voluntaria y por ley hay que preguntarla antes de sumarla.
  /// Acá solo se define la sugerencia que muestra la pantalla de cobro.
  tipSuggestionEnabled Boolean @default(true)
  tipSuggestionRateBp  Int     @default(1000)

  /// El efectivo se redondea al múltiplo más cercano porque no circulan monedas
  /// por debajo de $50. Solo afecta al pago en efectivo, nunca al total facturado.
  cashRoundingCop Int @default(50)

  /// Numeración de pedidos y de turnos: reinician cada día de negocio.
  orderNumberResetsDaily Boolean @default(true)
  turnNumberMax          Int     @default(99)

  /// Si está en true, no se puede abrir un pedido sin una caja abierta. Se apaga
  /// en negocios donde el mesero toma pedidos antes de que llegue el cajero.
  requireOpenCashSession Boolean @default(true)

  /// No todo negocio reparte a domicilio. Si está en false, "Domicilio" no
  /// aparece como tipo de pedido y no hace falta pedir dirección. Mesas se
  /// apaga aparte, como AppModule: es una pantalla entera (/salon), no un tipo
  /// de pedido dentro de otra pantalla.
  deliveryEnabled Boolean @default(true)
  /// Valor o tarifa fija del servicio de domicilio en COP.
  deliveryFeeCop  Int     @default(0)

  /// Si el negocio está recibiendo domicilios por QR AHORA MISMO.
  ///
  /// `deliveryEnabled` dice si el negocio reparte; esto dice si está abierto en
  /// este momento, y lo mueve el cajero al abrir y cerrar el turno. Son dos cosas
  /// distintas: un comensal podía mandar un domicilio a las 4 de la mañana, con la
  /// caja cerrada y sin nadie en el local, y el pedido esperaba a que alguien
  /// llegara a la mañana siguiente a descubrirlo.
  ///
  /// Arranca APAGADO a propósito: que el primer turno haya que encenderlo es una
  /// molestia de un clic; que un pedido entre sin que nadie lo espere es un cliente
  /// esperando comida que nadie está haciendo.
  qrDeliveryEnabled Boolean @default(false)

  /// Impresión térmica. El ancho decide el @page de app/imprimir.
  comandaDestino ComandaDestino @default(KDS)

  receiptWidth  ReceiptWidth @default(MM80)
  receiptHeader String?
  receiptFooter String?

  /// Imagen que el POS y la carta muestran para un producto sin foto propia.
  /// Se elige desde Configuración entre lo que el superadministrador cargó a
  /// Cloudinary; si el negocio no eligió ninguna, la carta usa la que el
  /// superadministrador marcó `isDefault`. Solo si tampoco hay esa cae al
  /// inicial tipográfico.
  defaultPlaceholderId String?
  defaultPlaceholder   PlaceholderImage? @relation(fields: [defaultPlaceholderId], references: [id], onDelete: SetNull)

  /// Configuración del Turnero para Televisor del Salón
  turneroMediaMode            String  @default("NONE")
  turneroImages               String  @default("[]")
  turneroImageIntervalSeconds Int     @default(10)
  turneroYoutubeUrl           String?
  turneroBadgePosition        String  @default("TOP_RIGHT")

  /// Módulos de Inventario y Recetas / Escandallos
  inventoryEnabled Boolean @default(false)
  recipesEnabled   Boolean @default(false)

  /// Deja cobrar aunque el inventario diga que no queda, y el stock queda en
  /// negativo. Apagado de fábrica: lo normal es que no se pueda vender lo que no
  /// hay. Encendido es para el negocio que prefiere no frenar la caja y cuadrar
  /// en el arqueo, y el negativo es justamente lo que ahí se tiene que ver: un
  /// stock que se queda en cero esconde el faltante.
  permitirVentaSinStock Boolean @default(false)

  /// Configuración del Menú Digital QR
  qrMenuEnabled        Boolean @default(true)
  qrMenuBgMode         String  @default("SOLID")
  /// El negro tibio de la marca (--tinta). Antes era #101416, un negro azulado
  /// que no sale de ninguna parte de la paleta.
  qrMenuBgColor        String  @default("#171512")
  qrMenuBgGradient     String  @default("linear-gradient(135deg, #171512 0%, #3A3733 100%)")
  qrMenuBgImageUrl     String?
  qrMenuLogoUrl        String?
  qrMenuHeaderTitle    String?
  qrMenuHeaderSubtitle String?
  /// El color con el que el menú pinta botones, precios y totales. Cada tema de
  /// marca ya traía el suyo, pero no había dónde guardarlo: los seis presets se
  /// veían distintos de fondo y todos con el naranja Platlia encima.
  qrMenuAccent         String  @default("#FF4E1F")

  /// Módulo Opcional de Facturación Electrónica DIAN (Factus)
  ///
  /// Las credenciales de Factus NO viven acá: la cuenta es una sola, de la
  /// plataforma, y está en el entorno (`FACTUS_*` en lib/env.ts). Factus nos vende
  /// una bolsa de documentos y el superadministrador la reparte; lo que queda por
  /// negocio es solo lo que la DIAN le autorizó a SU NIT.
  facturacionElectronicaHabilitada Boolean @default(false)
  paquetesDocumentosDisponibles    Int     @default(0)
  documentosEmitidosConsumidos     Int     @default(0)

  factusNumberingRangeId     Int?
  /// La nota crédito se emite con SU PROPIO rango, no con el de la factura: en la
  /// cuenta de Factus son resoluciones distintas ("Factura de Venta" vs "Nota
  /// Crédito"). Sin esto la nota crédito sale con el consecutivo equivocado.
  factusNumberingRangeIdNc   Int?
  municipalityCode           String? @default("05001")
  identificationDocumentCode String? @default("31")
  legalOrganizationCode      String? @default("1")
  tributeCode                String? @default("ZZ")
  responsibilities           String? @default("R-99-PN")

  /// Permisos de vista personalizados por rol (JSON serializado)
  rolePermissions String @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model BusinessModule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  module  AppModule
  enabled Boolean   @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([businessId, module])
}

/// El impuesto es dato, no código. Cada producto apunta a una tarifa y el valor
/// se congela en el OrderItem al agregarlo, para que un recibo viejo se reimprima
/// idéntico aunque la tarifa cambie después.
model TaxRate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  kind      TaxKind @default(IMPOCONSUMO)
  /// Puntos básicos: 800 = 8%.
  rateBp    Int     @default(800)
  isDefault Boolean @default(false)
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad y acceso
// ─────────────────────────────────────────────────────────────────────────────

/// El usuario es global, no por empresa: la misma persona puede ser dueña de un
/// bar y cajera en otro. El vínculo con el negocio y el rol viven en Membership.
model User {
  id String @id @default(cuid())

  /// Se normaliza a minúsculas antes de escribir, siempre. La unicidad de
  /// PostgreSQL distingue mayúsculas y sin normalizar entrarían dos cuentas para
  /// la misma persona.
  email        String  @unique
  passwordHash String
  name         String
  phone        String?

  status       UserStatus @default(ACTIVO)
  /// Un superadministrador no pertenece a ninguna empresa y entra por una cookie
  /// distinta (pl_sa, con path /superadmin), para que una sesión de soporte nunca
  /// se confunda con la sesión normal del producto.
  isSuperAdmin Boolean    @default(false)

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)

  /// Freno a la fuerza bruta. Se limpian al primer inicio de sesión correcto.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  memberships        Membership[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]
  ordersOpened       Order[]             @relation("OrderOpenedBy")
  ordersClosed       Order[]             @relation("OrderClosedBy")
  ordersCanceled     Order[]             @relation("OrderCanceledBy")
  orderItemsCreated  OrderItem[]         @relation("OrderItemCreatedBy")
  orderItemsCanceled OrderItem[]         @relation("OrderItemCanceledBy")
  orderItemsStarted  OrderItem[]         @relation("OrderItemStartedBy")
  tokensIaCreados    TokenIa[]           @relation("TokenIaCreatedBy")
  orderItemsReady    OrderItem[]         @relation("OrderItemReadyBy")
  paymentsReceived   OrderPayment[]      @relation("OrderPaymentReceivedBy")
  cashSessionsOpened CashSession[]       @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]       @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]      @relation("CashMovementCreatedBy")

  @@index([isSuperAdmin])
}

model Membership {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  role   Role
  active Boolean @default(true)

  /// PIN corto para el cambio rápido de operario en la tablet del salón, sin
  /// volver a escribir la contraseña. Se guarda hasheado igual que la contraseña.
  pinHash String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, businessId])
  @@index([businessId, active])
}

/// La sesión se guarda en base aunque la cookie sea un JWT firmado: el middleware
/// hace el chequeo optimista sin tocar la base, pero el DAL valida contra esta
/// tabla, que es lo que permite revocar una sesión de verdad (empleado despedido,
/// dispositivo perdido).
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Empresa activa de la sesión. Nula en sesiones de superadministrador y
  /// mientras el usuario todavía no eligió negocio.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  kind SessionKind @default(APP)

  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)

  ip        String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, kind])
  @@index([expiresAt])
}

/// Un solo uso: verificar el correo o restablecer la contraseña. Se guarda el
/// hash del token, no el token —igual que una contraseña— porque una fila de
/// esta tabla filtrada no puede regalar la cuenta de nadie.
///
/// `purpose` distingue las dos razones porque comparten forma entera: usuario,
/// vencimiento, un solo uso. Antes de emitir uno nuevo se borran los anteriores
/// sin usar del mismo usuario y propósito, así nunca hay dos enlaces vivos
/// compitiendo por ser "el" válido.
model VerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   VerificationTokenPurpose
  tokenHash String                   @unique

  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose])
}

// ─────────────────────────────────────────────────────────────────────────────
// Licencia y facturación
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(PRUEBA)

  /// No hay precio por empresa a propósito.
  ///
  /// Antes existía un `priceCop` que se congelaba al registrarse y le ganaba a la
  /// lista, para respetarle la tarifa a los primeros clientes cuando el precio
  /// subiera. El efecto era que el número que cobraba el sistema no estaba en
  /// ninguna pantalla editable: nacía solo y solo se podía cambiar por SQL.
  /// Hoy el precio sale ÚNICAMENTE de `ListaDePrecios`, que edita el
  /// superadministrador en /superadmin/precios.

  /// Número máximo de sucursales permitidas (1 por defecto, 2 self-service con prorrateo, 3+ controlado por superadmin).
  maxBranches Int @default(1)

  trialEndsAt        DateTime? @db.Timestamptz(3)
  currentPeriodStart DateTime? @db.Timestamptz(3)
  currentPeriodEnd   DateTime? @db.Timestamptz(3)
  /// Días de gracia después del vencimiento: la app sigue funcionando pero avisa.
  /// requireActiveLicense() compara contra esta fecha, no contra currentPeriodEnd.
  graceUntil         DateTime? @db.Timestamptz(3)
  canceledAt         DateTime? @db.Timestamptz(3)

  /// Cada cuánto cobra el débito automático: "MENSUAL" o "ANUAL". Null si está
  /// apagado. Se guarda porque el monto depende de esto y hay que poder
  /// reconstruir qué se autorizó.
  cobroAutomatico String?

  /// La última clave de aviso de vencimiento que se mandó, como
  /// "2026-09-03T00:00:00.000Z:3". Es una sola columna en vez de una por umbral:
  /// incluye la fecha de corte, así que al renovarse la licencia la clave cambia
  /// sola y los avisos del período nuevo vuelven a salir sin tener que limpiar
  /// nada. El cron corre todos los días y sin esto mandaría el mismo correo cada
  /// mañana durante tres días seguidos.
  ultimoAvisoClave String?

  /// Suscripción automática de MercadoPago, cuando el cliente la autoriza.
  mpPreapprovalId String? @unique
  mpPayerId       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  payments SubscriptionPayment[]

  @@index([status, currentPeriodEnd])
}

model SubscriptionPayment {
  id String @id @default(cuid())

  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amountCop Int
  status    PaymentStatus @default(PENDIENTE)

  /// Cuántos meses de servicio compró este pago. Sin esto, el webhook sumaba
  /// siempre uno: pagar un año daba un mes y no había forma de notarlo.
  mesesOtorgados Int    @default(1)
  /// "MENSUAL" | "SEMESTRAL" | "ANUAL". Se guarda para poder reconstruir qué se
  /// vendió aunque la lista de precios haya cambiado después.
  periodicidad   String @default("MENSUAL")
  /// Cuántas sedes cubría el cobro cuando se hizo.
  sedes          Int    @default(1)

  /// Único: es la llave de idempotencia contra los reenvíos del webhook, que
  /// MercadoPago hace varias veces por el mismo pago.
  mpPaymentId    String? @unique
  mpPreferenceId String?
  mpStatusDetail String?
  method         String?

  periodStart DateTime? @db.Timestamptz(3)
  periodEnd   DateTime? @db.Timestamptz(3)
  paidAt      DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([businessId, createdAt])
  @@index([subscriptionId, status])
}

/// Bitácora cruda de notificaciones de MercadoPago. Existe para dos cosas: cortar
/// el reproceso de un evento repetido y poder reconstruir qué llegó exactamente
/// cuando un cobro se discute.
model MpWebhookEvent {
  id String @id @default(cuid())

  /// El `id` de la notificación. Único: la segunda entrega del mismo evento se
  /// rechaza en el índice, no en la lógica.
  mpEventId String @unique
  type      String

  payload     Json
  processedAt DateTime? @db.Timestamptz(3)
  error       String?

  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([type, receivedAt])
}

/// La lista de precios de la plataforma. No es de un negocio: es de Platlia, y la
/// edita el superadministrador.
///
/// Existe porque el precio estaba escrito a mano en seis archivos y ya habían
/// divergido entre sí. Guardar filas en vez de columnas sueltas deja además el
/// historial de qué se cobraba en cada momento, que es lo que se necesita cuando
/// un cliente pregunta por qué le cobraron lo que le cobraron.
///
/// Una fila sin fechas es la lista base y rige siempre. Una fila con fechas es una
/// promoción y le gana a la base mientras esté dentro de su ventana.
/// Una impresora térmica en la red del local.
///
/// El servidor NUNCA le habla directamente: la impresora vive en la LAN de la
/// sucursal, detrás del router del bar, y desde internet no se llega. Lo que hay
/// acá es la descripción que necesita el agente que sí está en esa red.
model Printer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Cómo la llama el personal: "Caja", "Cocina", "Barra".
  name String
  rol  PrinterRole

  /// Dónde encontrarla en la LAN. 9100 es el puerto crudo de casi toda térmica.
  host String
  port Int    @default(9100)

  width     ReceiptWidth @default(MM80)
  /// Manda el pulso que abre el cajón de dinero al terminar de imprimir.
  abreCajon Boolean      @default(false)
  active    Boolean      @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  rutas PrintRoute[]
  jobs  PrintJob[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

/// A qué impresora va la comanda de cada estación.
///
/// `Product.kitchenStation` es texto libre —"Cocina", "Barra", "Parrilla"— sin
/// tabla ni FK, y el KDS ya agrupa por ese string. Mapear acá en vez de
/// normalizarlo evita migrar datos escritos a mano y deja el nombre canónico
/// "Sin estación" como el que recibe la impresora por defecto.
model PrintRoute {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  stationName String
  printerId   String
  printer     Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([businessId, stationName])
  @@index([businessId])
}

/// La cola de impresión. Durable a propósito.
///
/// Redis Pub/Sub es fire-and-forget: lo que se publica con el agente apagado se
/// pierde y nadie se entera. Para un contador de pantalla está bien; para una
/// comanda no. Así que la cola vive acá y Redis queda de timbre —"vení a
/// buscar"—, que es el mismo papel que ya cumple para cocina y domicilios.
model PrintJob {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// "RECIBO" | "COMANDA" | "PRUEBA". Para leer la cola sin adivinar.
  tipo String

  /// Los bytes ESC/POS ya compuestos, en base64. El agente los escribe tal cual
  /// en el socket: toda la decisión de formato es del servidor, que es donde se
  /// puede probar.
  payload String

  /// El mismo tiquete en texto plano. Es lo que mira soporte cuando alguien dice
  /// "salió mal": decodificar base64 para ver por qué se descuadró una columna no
  /// lo va a hacer nadie.
  vistaPrevia String

  estado      PrintJobStatus @default(PENDIENTE)
  intentos    Int            @default(0)
  ultimoError String?

  /// El reclamo caduca: un agente que se muere con el trabajo en la mano no lo
  /// bloquea para siempre.
  reclamadoPor   String?
  reclamadoHasta DateTime? @db.Timestamptz(3)

  impresoEn DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([businessId, estado, createdAt])
  @@index([printerId, estado])
}

/// El programa que corre en una PC del local y habla con las impresoras.
///
/// Se autentica con un token del que se guarda **solo el hash**, igual que
/// `VerificationToken`: una copia de la base no regala el acceso a la cola de
/// impresión de nadie. No hay sesión ni cookie —no es un navegador—, así que es
/// el mismo patrón que el webhook de MercadoPago: la ruta es pública y se
/// verifica por su cuenta.
/**
 * La llave con la que la IA de un negocio lee SU información.
 *
 * Cada fila es una conexión: "el ChatGPT de Ana", "el Claude del celular del
 * administrador". Del token se guarda **solo el hash**, igual que en
 * `PrintAgent` y `VerificationToken`: una copia de la base no le regala a nadie
 * la contabilidad de un local.
 *
 * SHA-256 y no argon2, por lo mismo que el agente de impresión: son 32 bytes
 * aleatorios y no una contraseña que alguien repite en otro lado, y el hash se
 * verifica en cada pregunta que hace el asistente.
 *
 * `ultimoUsoEn` no es adorno: es lo único que le permite al dueño ver que una
 * conexión que creyó apagada sigue viva, o darse cuenta de que la que configuró
 * nunca funcionó.
 *
 * Revocar BORRA la fila. Un hash revocado que se queda en la tabla es una llave
 * vieja esperando a que alguien se equivoque en la consulta; quién tuvo acceso y
 * hasta cuándo queda en `AuditLog`, que es donde se revisa eso.
 */
model TokenIa {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Cómo lo llama el dueño, para saber cuál apagar.
  nombre String

  tokenHash String @unique

  createdById String?
  createdBy   User?   @relation("TokenIaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  ultimoUsoEn DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([businessId])
}

model PrintAgent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  nombre String

  /**
   * Null hasta que el programa se empareja.
   * El equipo se registra desde el panel ANTES de que exista el programa: en ese
   * momento hay un código de emparejamiento y todavía no un token.
   */
  tokenHash String? @unique

  /**
   * El código que canjea el programa por su token, hasheado y con vencimiento.
   * Existe para que nadie tenga que copiar un token de 43 caracteres: viaja en el
   * NOMBRE del archivo que se descarga, así que el programa lo lee de sí mismo y
   * se configura solo. Se usa una vez y se vence, que es lo que permite que sea
   * corto.
   */
  codigoHash     String?   @unique
  codigoExpiraEn DateTime? @db.Timestamptz(3)
  emparejadoEn   DateTime? @db.Timestamptz(3)

  ultimoContactoEn DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([businessId])
}

model ListaDePrecios {
  id     String @id @default(cuid())
  nombre String

  precioSedePrincipalCop Int @default(50000)
  precioSedeAdicionalCop Int @default(30000)

  /// Escalones por cantidad de sedes. Sin ninguno rige la fórmula
  /// `principal + adicional × (n − 1)`, que es lo razonable hasta dos locales;
  /// de tres para arriba el precio se negocia y necesita decirse entero.
  tramos TramoDePrecios[]

  /// El descuento son meses de regalo, no un porcentaje: "un mes va de regalo" se
  /// entiende sin calculadora y no deja centavos que redondear.
  mesesGratisSemestral Int @default(1)
  mesesGratisAnual     Int @default(2)

  desde  DateTime? @db.Timestamptz(3)
  hasta  DateTime? @db.Timestamptz(3)
  activa Boolean   @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([activa, desde, hasta])
}

/// Un escalón de precio por cantidad de sedes dentro de una lista.
///
/// `desdeSedes` es el piso del tramo y no hay techo: manda el tramo de piso más
/// alto que no supere la cantidad de sedes. Así "3" cubre 3, 4 y 5 hasta que
/// aparezca un "6", y agregar un escalón nunca obliga a reescribir los otros.
model TramoDePrecios {
  id      String         @id @default(cuid())
  listaId String
  lista   ListaDePrecios @relation(fields: [listaId], references: [id], onDelete: Cascade)

  desdeSedes       Int
  precioMensualCop Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([listaId, desdeSedes])
  @@index([listaId, desdeSedes])
}

/// Cada compra de documentos electrónicos que Platlia le hace a Factus.
///
/// Es de la plataforma, no de un negocio —como `ListaDePrecios`— y la escribe
/// solo la consola. Existe porque el reparto se estaba haciendo a ciegas: el
/// superadministrador ya sumaba documentos a cada empresa
/// (`paquetesDocumentosDisponibles`) sin que hubiera en ningún lado cuántos
/// habíamos comprado, así que no había forma de saber cuántos quedaban sin
/// asignar hasta que la bolsa se agotaba en medio del servicio de alguien.
///
/// Se guardan las compras una por una en vez de un contador: así queda el
/// historial de qué se compró, cuándo y a cuánto.
model CompraDocumentosDian {
  id       String  @id @default(cuid())
  cantidad Int
  /// Lo que nos costó el paquete. Es dato de plataforma, no se le cobra a nadie.
  costoCop Int     @default(0)
  nota     String?

  compradoEn DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([compradoEn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  color     String?
  imageUrl  String?
  active    Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  products Product[]

  @@unique([businessId, name])
  @@index([businessId, active, sortOrder])
}

model Product {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name             String
  shortDescription String?
  description      String?
  sku              String?
  imageUrl         String?

  /// Precio de lista. Si BusinessSettings.pricesIncludeTax es true, ya incluye
  /// el impuesto y lib/tax.ts lo desagrega.
  priceCop Int

  taxRateId String
  taxRate   TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  /// `active` es catálogo (el producto existe); `isAvailable` es hoy (se acabó).
  isAvailable Boolean @default(true)

  /// Inventario opcional: la mayoría de los bares no lo lleva y no hay que
  /// obligarlos. Cuando trackStock es false, stockQty se ignora.
  ///
  /// Es el régimen de stock DIRECTO: una cerveza que se compra y se revende tal
  /// cual. Es excluyente con `hasRecipe` —lo que se mide por sus insumos no se
  /// mide además por unidades— porque contar la misma cerveza en los dos lados
  /// es descontarla dos veces o ninguna, según cuál de los dos mire quien lee.
  trackStock Boolean @default(false)
  stockQty   Int     @default(0)

  /// Costo unitario de compra y mínimo de reposición del régimen directo. Son
  /// los equivalentes de `InventoryItem.costCop` y `stockMin` para el producto
  /// que NO tiene receta: sin receta no hay insumo del cual sacarlos, y sin
  /// costo no hay margen que informar.
  ///
  /// `costCop` es promedio ponderado y NETO de impuesto: se recalcula en cada
  /// factura de compra con `costoPromedioPonderado`, y el margen se compara
  /// contra la base gravable del renglón vendido, no contra el precio de carta.
  costCop  Int @default(0)
  stockMin Int @default(0)

  /// Lleva escandallo: descuenta insumos al venderse y aparece en
  /// Inventario → Recetas. Sin esto marcado no tiene receta y no descuenta nada,
  /// por más que le queden `recipeItems` de antes. Es una declaración del dueño,
  /// no una consecuencia de que la tabla tenga filas.
  ///
  /// Excluyente con `trackStock`: ver el comentario de arriba.
  hasRecipe Boolean @default(false)

  /// La receta depende de lo que se elija al vender: no se descuenta nada hasta
  /// que se eligen los modificadores. Solo tiene sentido con `hasRecipe` y con
  /// al menos un grupo obligatorio asignado.
  recipeNeedsModifiers Boolean @default(false)

  /// Estación de la pantalla de cocina: "Cocina", "Barra", "Parrilla".
  kitchenStation     String?
  preparationMinutes Int?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orderItems     OrderItem[]
  recipeItems    ProductRecipeItem[]
  modifierGroups ProductModifierGroup[]
  movements      InventoryMovement[]

  @@unique([businessId, sku])
  @@index([businessId, categoryId, sortOrder])
  @@index([businessId, active, isAvailable])
}

/// Biblioteca de fotos genéricas en Cloudinary que el superadministrador cura
/// desde /superadmin, para negocios que no suben sus propias fotos de producto.
/// Es global, no de una empresa: `businessId` no aplica y por eso se consulta con
/// rootDb, nunca con tenantDb().
model PlaceholderImage {
  id String @id @default(cuid())

  /// Cómo la ve el propietario al elegirla desde Configuración: "Cerveza",
  /// "Plato genérico". Es una etiqueta, no una categoría de producto.
  label    String
  imageUrl String

  /// La que usa cualquier negocio que no eligió una propia. Solo puede haber una
  /// verdadera a la vez; eso lo cuida la acción que la marca, no una constraint
  /// de base —el mismo patrón que TaxRate.isDefault.
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  businesses BusinessSettings[]

  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Salón
// ─────────────────────────────────────────────────────────────────────────────

model Area {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tables Table[]
  orders Order[]

  @@unique([businessId, name])
  @@index([businessId, active, sortOrder])
}

model Table {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  /// Etiqueta visible: "12", "Barra 3". Es texto porque no todas las mesas se
  /// numeran.
  name      String
  capacity  Int         @default(4)
  status    TableStatus @default(LIBRE)
  sortOrder Int         @default(0)

  /// Posición en el plano del salón, en porcentaje del contenedor. Nulas mientras
  /// el dueño no acomode el mapa.
  posX Int?
  posY Int?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orders Order[]

  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([businessId, areaId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pedidos
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Consecutivo visible, reiniciable por día de negocio. `businessDate` lo
  /// calcula lib/time.ts con la zona horaria y el corte de día de la empresa y
  /// llega siempre como parámetro.
  code         Int
  businessDate DateTime @db.Date

  /// Número que se canta y se muestra en el televisor del salón. Rota al llegar
  /// a BusinessSettings.turnNumberMax. Solo para pedidos que se esperan.
  ///
  /// NO es único dentro de la jornada, y no puede serlo: rotar significa
  /// repetirse, y un índice único convertía el tope en un techo de pedidos para
  /// llevar por día. Quien evita que dos personas esperando compartan número es
  /// `abrirPedido`, que saltea los turnos que siguen en el televisor.
  turnNumber Int?

  type    OrderType    @default(MESA)
  channel OrderChannel @default(POS)
  status  OrderStatus  @default(ABIERTA)

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  areaId  String?
  area    Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  guestsCount Int?

  /// La etiqueta de la CUENTA, no el nombre fiscal: "Andrés", "Cuenta 2". Una
  /// mesa puede tener varias cuentas abiertas a la vez —un grupo que pide por
  /// separado— y esto es lo que las distingue en el salón, en la comanda de
  /// cocina y en el tiquete. A quién se le factura lo deciden `docType` y
  /// `docNumber`: sin número de documento, la factura sale a consumidor final y
  /// este nombre ni se mira.
  customerName    String?
  customerPhone   String?
  /// Correo al que se manda la factura electrónica. Sin esto Factus cae a un
  /// literal del código y la factura no le llega a nadie.
  customerEmail   String?
  deliveryAddress String?
  docType         String?
  docNumber       String?
  /// Null en todo lo que no es un domicilio: una mesa no tiene reparto.
  ///
  /// Antes era un `String` con `@default("PENDIENTE")`, así que **todos** los
  /// pedidos del negocio lo tenían puesto y no servía para filtrar nada —por eso
  /// las consultas de domicilios necesitan el OR de `type`/`channel`—. Los
  /// valores válidos vivían copiados a mano en tres archivos.
  deliveryStatus  DeliveryStatus?

  /// Cuándo lo aceptó el módulo de domicilios, cuándo salió a la calle y cuándo
  /// llegó. Sin estas marcas no hay forma de saber cuánto tarda un reparto.
  deliveryConfirmedAt DateTime? @db.Timestamptz(3)
  dispatchedAt        DateTime? @db.Timestamptz(3)
  deliveredAt         DateTime? @db.Timestamptz(3)

  notes String?

  /// Facturación Electrónica DIAN (Factus)
  ///
  /// `facturaElectronicaCufe` es la guarda anti-doble-emisión: mientras esté en
  /// null la venta se puede facturar (o reintentar), y una vez que tiene CUFE no
  /// se vuelve a emitir nunca. `facturaElectronicaEstado` es "EMITIDA" | "ERROR" |
  /// null y sirve para pintar el estado, no para decidir.
  facturaElectronicaNumero String?
  facturaElectronicaCufe   String?
  facturaElectronicaUrlPdf String?
  facturaElectronicaUrlQr  String?
  facturaElectronicaEstado String?
  facturaElectronicaFecha  DateTime? @db.Timestamptz(3)
  facturaElectronicaError  String?

  /// Nota crédito: una factura emitida no se borra, se corrige. Anular una venta
  /// ya facturada sin emitir la nota dejaría la factura viva ante la DIAN.
  notaCreditoNumero String?
  notaCreditoCufe   String?
  notaCreditoUrlPdf String?
  notaCreditoFecha  DateTime? @db.Timestamptz(3)
  notaCreditoError  String?

  /// Totales denormalizados. Se recalculan enteros en cada cambio de ítem, dentro
  /// de la misma transacción: los informes no pueden depender de sumar renglones
  /// en el momento de leer.
  subtotalCop    Int @default(0)
  discountCop    Int @default(0)
  taxCop         Int @default(0)
  tipCop         Int @default(0)
  deliveryFeeCop Int @default(0)
  totalCop       Int @default(0)
  paidCop        Int @default(0)

  openedById String
  openedBy   User    @relation("OrderOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById String?
  closedBy   User?   @relation("OrderClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  canceledById   String?
  canceledBy     User?     @relation("OrderCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  canceledReason String?
  canceledAt     DateTime? @db.Timestamptz(3)

  openedAt        DateTime  @default(now()) @db.Timestamptz(3)
  billRequestedAt DateTime? @db.Timestamptz(3)
  closedAt        DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  items     OrderItem[]
  payments  OrderPayment[]
  printJobs PrintJob[]

  @@unique([businessId, businessDate, code])
  @@index([businessId, businessDate, turnNumber])
  @@index([businessId, status])
  @@index([businessId, deliveryStatus])
  @@index([businessId, businessDate])
  @@index([businessId, tableId, status])
  @@index([businessId, cashSessionId])
}

/// El renglón congela nombre, precio e impuesto en el momento de agregarlo. Un
/// tiquete reimpreso seis meses después tiene que salir idéntico al original,
/// aunque el producto haya subido de precio o cambiado de tarifa.
model OrderItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Instantánea: si el producto vendido era una presentación, ya no existe como
  /// tal —cada presentación es su propio Product— así que esto es lo único que
  /// queda de "qué era" en un tiquete viejo.
  nameSnapshot         String
  /// Ya incluye los recargos de los modificadores elegidos: todo el cálculo de
  /// impuesto y de totales sigue leyendo un solo precio, como antes de que
  /// existieran los modificadores.
  unitPriceCop         Int
  /// El precio de lista del producto, sin recargos. Es lo único que permite
  /// desglosar "plato $18.000 + carne $2.000" en un tiquete reimpreso.
  basePriceCopSnapshot Int
  taxRateBpSnapshot    Int
  taxRateNameSnapshot  String
  /// También congelado, y por el mismo motivo que los otros tres: la DIAN separa
  /// IVA (código 01) de impuesto al consumo (04), y el `kind` solo vivía en
  /// `TaxRate`, alcanzable únicamente por el producto ACTUAL. Facturar leyendo de
  /// ahí sería declarar una venta vieja con la tarifa de hoy.
  taxKindSnapshot      TaxKind @default(IMPOCONSUMO)
  /// También se congela: si mañana el negocio cambia a precios sin impuesto
  /// incluido, este renglón tiene que seguir desagregándose como se cobró.
  taxIncludedSnapshot  Boolean

  quantity    Int @default(1)
  discountCop Int @default(0)

  /// Calculados con lib/tax.ts y redondeados POR LÍNEA, nunca sobre el total.
  lineSubtotalCop Int
  lineTaxCop      Int
  lineTotalCop    Int

  /// Lo que costó preparar este renglón, congelado al venderlo por el mismo
  /// motivo que la tarifa: un informe de marzo tiene que seguir dando lo mismo
  /// en diciembre aunque el proveedor haya subido tres veces. Sale de
  /// `Product.costCop` en el régimen directo y de la suma de la receta efectiva
  /// —base más los insumos de los modificadores elegidos— en el otro.
  ///
  /// NULL no es cero: es "no se conocía el costo" (inventario apagado, producto
  /// sin costear). La diferencia importa porque con cero el informe anunciaría
  /// margen del 100%, que es peor que no informar nada.
  unitCostCopSnapshot Int?
  lineCostCop         Int?

  status OrderItemStatus @default(PENDIENTE)
  notes  String?

  createdById String
  createdBy   User   @relation("OrderItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  canceledById   String?
  canceledBy     User?     @relation("OrderItemCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  canceledReason String?
  canceledAt     DateTime? @db.Timestamptz(3)

  /// Quién lo tomó en la cocina, y quién lo dio por terminado.
  ///
  /// `startedById` es la firma de la comanda: quien toca "empezar" en el KDS se
  /// hace cargo del plato, y es el único que puede después marcarlo listo. Sin
  /// eso, dos cocineros tocan el mismo renglón y ninguno sabe si el otro ya lo
  /// está haciendo.
  ///
  /// `readyById` existe aparte —y no se deduce del anterior— porque un jefe de
  /// cocina puede destrabar un renglón que quedó a nombre de alguien que se fue.
  /// Cuando los dos no coinciden, ese tiempo no es tiempo de cocción de nadie y
  /// el informe tiene que poder dejarlo afuera en vez de cargárselo al que
  /// empezó.
  ///
  /// Los dos son NULL en todo lo anterior a esta columna, y en todo negocio que
  /// imprime la comanda en papel en vez de usar el KDS: ahí no hay ningún toque
  /// que registrar, y el informe lo dice en vez de mostrar ceros.
  startedById String?
  startedBy   User?   @relation("OrderItemStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  readyById   String?
  readyBy     User?   @relation("OrderItemReadyBy", fields: [readyById], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  sentToKitchenAt DateTime? @db.Timestamptz(3)
  /// Cuándo alguien lo tomó. Es la marca que faltaba: `sentToKitchenAt` dice
  /// cuándo entró a la plancha y `readyAt` cuándo salió, pero sin esto los dos
  /// tramos —lo que esperó y lo que se cocinó— eran un solo número indistinguible.
  startedAt       DateTime? @db.Timestamptz(3)
  readyAt         DateTime? @db.Timestamptz(3)
  deliveredAt     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  modifiers OrderItemModifier[]

  @@index([businessId, orderId])
  @@index([businessId, status, createdAt])
  @@index([businessId, productId])
}

model OrderPayment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  method    PaymentMethod
  amountCop Int

  /// Con cuánto pagó y cuánto se le devolvió. Solo aplican al efectivo y quedan
  /// guardados porque el cierre de caja los necesita para explicar diferencias.
  tenderedCop Int?
  changeCop   Int?

  /// Referencia externa: últimos dígitos del datáfono, número de aprobación de
  /// Nequi, etc.
  reference String?

  receivedById String
  receivedBy   User   @relation("OrderPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  voidedAt     DateTime? @db.Timestamptz(3)
  voidedReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, orderId])
  @@index([businessId, cashSessionId, method])
}

// ─────────────────────────────────────────────────────────────────────────────
// Caja
// ─────────────────────────────────────────────────────────────────────────────

model CashSession {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  code         Int
  businessDate DateTime          @db.Date
  status       CashSessionStatus @default(ABIERTA)

  /// Base con la que se abre la caja.
  openingFloatCop Int @default(0)

  /// Se llenan al cerrar: lo que el sistema calculó, lo que la persona contó y la
  /// diferencia. Se guarda la diferencia y no se recalcula al leer, porque el
  /// cálculo esperado depende de datos que después se pueden corregir.
  expectedCashCop Int?
  countedCashCop  Int?
  differenceCop   Int?

  notes String?

  openedById String
  openedBy   User    @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById String?
  closedBy   User?   @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  openedAt  DateTime  @default(now()) @db.Timestamptz(3)
  closedAt  DateTime? @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  orders    Order[]
  payments  OrderPayment[]
  movements CashMovement[]

  @@unique([businessId, businessDate, code])
  @@index([businessId, status])
}

/// Entradas y salidas que no son ventas: pagar el domicilio del hielo, retirar
/// efectivo a la caja fuerte, corregir un faltante.
model CashMovement {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  type       CashMovementType
  amountCop  Int
  concept    String
  /// Foto del recibo del gasto, subida a Cloudinary.
  receiptUrl String?

  createdById String
  createdBy   User   @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, cashSessionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────────────────────────────────────

/// Rastro de lo que no se puede discutir después: anulaciones, descuentos,
/// cambios de precio, cierres de caja con diferencia. `businessId` y `userId` son
/// opcionales porque también se registran acciones de superadministrador y
/// eventos del sistema.
model AuditLog {
  id String @id @default(cuid())

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  metadata Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, createdAt])
  @@index([businessId, entity, entityId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventario, Facturas de Compra y Recetas / Escandallos
// ─────────────────────────────────────────────────────────────────────────────

/// Insumos, ingredientes o productos que se gestionan en stock.
model InventoryItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  sku          String?
  unit         String  @default("UNIDAD")
  stockCurrent Int     @default(0)
  stockMin     Int     @default(0)
  costCop      Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  recipeItems      ProductRecipeItem[]
  invoiceItems     PurchaseInvoiceItem[]
  movements        InventoryMovement[]
  modifierSupplies ModifierOptionSupply[]

  @@index([businessId, deletedAt])
}

/// Proveedores de insumos y productos.
model Supplier {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  taxId   String?
  phone   String?
  email   String?
  address String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  invoices PurchaseInvoice[]

  @@index([businessId, deletedAt])
}

/// Facturas de compra registradas a proveedores.
model PurchaseInvoice {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  invoiceNumber String
  invoiceDate   DateTime @db.Timestamptz(3)
  includesTax   Boolean  @default(true)
  subtotalCop   Int      @default(0)
  taxCop        Int      @default(0)
  totalCop      Int      @default(0)
  notes         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  items PurchaseInvoiceItem[]

  @@index([businessId, invoiceDate])
}

/// Línea de factura de compra.
model PurchaseInvoiceItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  quantity    Int
  unitCostCop Int
  taxRateBp   Int @default(0)
  totalCop    Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, invoiceId])
}

/// Receta / Escandallo: insumos requeridos por cada porción/unidad de producto.
model ProductRecipeItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  quantityRequired Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, inventoryItemId])
  @@index([businessId, productId])
}

/// Historial Kardex de entradas, compras, ventas y ajustes de stock.
///
/// Cubre los dos regímenes, y por eso las dos referencias son opcionales: una
/// fila apunta a un `InventoryItem` (insumo de receta) **o** a un `Product`
/// (reventa con stock directo), nunca a los dos. Antes solo existía la primera,
/// así que todo el movimiento de `Product.stockQty` —compras, ventas, ajustes—
/// pasaba sin dejar ningún rastro que revisar cuando el conteo no cuadra.
model InventoryMovement {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  type        String
  quantity    Int
  stockAfter  Int
  unitCostCop Int
  referenceId String?
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, inventoryItemId, createdAt])
  @@index([businessId, productId, createdAt])
  /// Para barrer una jornada entera sin filtrar por un item: el índice de arriba
  /// arranca por `inventoryItemId` y no sirve para eso.
  @@index([businessId, createdAt])
}

/// Grupo de modificadores reutilizable: "Proteína", "Término de la carne",
/// "Adiciones".
///
/// Es biblioteca de la empresa, no del producto: la misma "Proteína" la usan el
/// menú del día y la bandeja paisa, y cambiar el gramaje del pollo se hace en un
/// solo lugar. Qué productos lo usan lo dice `ProductModifierGroup`.
model ModifierGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  /// Ayuda que se muestra bajo el título en el modal de venta.
  helpText String?

  /// `minSelect` 0 = se puede no elegir nada. `maxSelect` 1 = una sola opción
  /// (el modal pinta botones excluyentes); mayor a 1 = varias. Estos dos números
  /// son lo único que decide la forma del modal: no hay un campo "tipo".
  minSelect Int @default(1)
  maxSelect Int @default(1)

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@unique([businessId, name])
  @@index([businessId, active, sortOrder])
}

/// Una opción concreta del grupo: "Pollo", "Término medio", "Extra queso".
model ModifierOption {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String

  /// Recargo sobre el precio del renglón, en pesos enteros. 0 = sin costo, que
  /// es el caso normal de "término de la carne".
  priceDeltaCop Int @default(0)

  /// Viene marcada al abrir el modal. Ahorra un toque en el caso frecuente.
  isDefault Boolean @default(false)

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  supplies      ModifierOptionSupply[]
  orderItemMods OrderItemModifier[]

  @@unique([groupId, name])
  @@index([businessId, groupId, sortOrder])
}

/// Los insumos que consume una opción: "Pollo" → 150 g de pechuga.
///
/// Mismo contrato que `ProductRecipeItem`: cantidad `Int` en la unidad del
/// insumo, sin decimales y sin conversión de unidades.
model ModifierOptionSupply {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  optionId String
  option   ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  quantityRequired Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([optionId, inventoryItemId])
  @@index([businessId, optionId])
}

/// Qué grupos usa cada producto.
///
/// `required` es override por producto: el mismo grupo "Adiciones" puede ser
/// obligatorio en un combo y opcional en un plato suelto, sin duplicar el grupo.
model ProductModifierGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  required  Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([productId, groupId])
  @@index([businessId, productId, sortOrder])
}

/// Qué modificadores llevaba un renglón vendido.
///
/// Congelado como el resto del renglón: el nombre del grupo, el de la opción y
/// el recargo se copian acá. Un tiquete reimpreso en seis meses sale idéntico
/// aunque la opción se haya renombrado, se le haya cambiado el precio o se haya
/// borrado del catálogo —por eso `optionId` es opcional y `SetNull`: sirve para
/// trazar de vuelta, no para leer los datos.
model OrderItemModifier {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  optionId String?
  option   ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  groupNameSnapshot     String
  optionNameSnapshot    String
  priceDeltaCopSnapshot Int    @default(0)
  sortOrder             Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([businessId, orderItemId])
}
